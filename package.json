{
  "name": "bluetoothaudioapp",
  "version": "1.0.0",
  "description": "STADEL Cross-Platform Bluetooth & WiFi Audio Sharing Application",
  "author": "STADEL Team <support@stadel.app>",
  "main": "node_modules/expo/AppEntry.js",
  "dependencies": {
    "@expo/ui": "~57.0.8",
    "buffer": "^6.0.3",
    "expo": "~57.0.9",
    "@expo/vector-icons": "^14.0.4",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tcp-socket": "^6.4.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop:dev": "NODE_ENV=development ELECTRON_START_URL=http://localhost:8082 electron ./desktop/main.js",
    "desktop:clean": "node ./scripts/clean-desktop-build.js",
    "desktop:build": "npm run desktop:clean && expo export --platform web && electron-builder --config electron-builder.json",
    "desktop:build:linux": "npm run desktop:clean && expo export --platform web && electron-builder --linux AppImage deb --config electron-builder.json",
    "desktop:build:win": "npm run desktop:clean && expo export --platform web && electron-builder --win nsis portable --config electron-builder.json",
    "desktop:build:mac": "npm run desktop:clean && expo export --platform web && electron-builder --mac dmg --config electron-builder.json",
    "lint": "expo lint"
  },
  "private": true
}
